generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  password             String
  phone                String?
  department           String?
  role                 Role                  @default(EMPLOYEE)
  assignedCash         PetitCashAssignment[] @relation("AssignedTo")
  assignmentsMade      PetitCashAssignment[] @relation("AssignedBy")
  payments             Payment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

enum Role {
  EMPLOYEE
  ACCOUNTANT
}

model PetitCashAssignment {
  id              String         @id @default(cuid())
  amount          Float
  assignedToId    String
  assignedTo      User           @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById    String
  assignedBy      User           @relation("AssignedBy", fields: [assignedById], references: [id])
  
  authorizedItems BudgetItem[]
  payments        Payment[]

  createdAt       DateTime       @default(now())
}

model BudgetItem {
  id              String                @id @default(cuid())
  name            String                @unique
  assignments     PetitCashAssignment[]
  payments        Payment[]
  createdAt       DateTime              @default(now())
}

model Payment {
  id             String      @id @default(cuid())
  vendorNumber   String
  amount         Float
  reason         String
  images         String[]
  idempotencyKey String?     @unique
  
  employeeId     String
  employee       User        @relation(fields: [employeeId], references: [id])
  
  assignmentId   String
  assignment     PetitCashAssignment @relation(fields: [assignmentId], references: [id])
  
  budgetItemId   String?
  budgetItem     BudgetItem? @relation(fields: [budgetItemId], references: [id])

  createdAt      DateTime @default(now())
}
