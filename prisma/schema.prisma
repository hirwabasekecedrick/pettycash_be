generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String                   @id @default(uuid())
  name        String
  users       User[]
  assignments PetitCashAssignment[]
  budgetItems BudgetItem[]
  payments    Payment[]
  theme       Theme?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Theme {
  id              String      @id @default(uuid())
  tenantId        String      @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor    String   @default("#0f172a")
  secondaryColor  String   @default("#f1f5f9")
  accentColor     String   @default("#3b82f6")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#020617")
  successColor    String   @default("#22c55e")
  warningColor    String   @default("#eab308")
  errorColor      String   @default("#ef4444")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id              String                   @id @default(uuid())
  name            String
  email           String                @unique
  password        String
  phone           String?
  department      String?
  role            Role                  @default(EMPLOYEE)
  tenantId        String?
  tenant          Tenant?               @relation(fields: [tenantId], references: [id])
  assignedCash    PetitCashAssignment[] @relation("AssignedTo")
  assignmentsMade PetitCashAssignment[] @relation("AssignedBy")
  payments        Payment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

enum Role {
  EMPLOYEE
  ACCOUNTANT
}

model PetitCashAssignment {
  id           String     @id @default(uuid())
  amount       Float
  assignedToId String
  assignedTo   User    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User    @relation("AssignedBy", fields: [assignedById], references: [id])
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id])

  authorizedItems BudgetItem[]
  payments        Payment[]

  createdAt DateTime @default(now())
}

model BudgetItem {
  id          String                   @id @default(uuid())
  name        String                @unique
  tenantId    String?
  tenant      Tenant?               @relation(fields: [tenantId], references: [id])
  assignments PetitCashAssignment[]
  payments    Payment[]
  createdAt   DateTime              @default(now())
}

model Payment {
  id             String      @id @default(uuid())
  vendorNumber   String
  amount         Float
  reason         String?
  images         String[] // Array of local paths or URLs
  idempotencyKey String?  @unique

  employeeId String
  employee   User @relation(fields: [employeeId], references: [id])

  assignmentId String
  assignment   PetitCashAssignment @relation(fields: [assignmentId], references: [id])

  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}
